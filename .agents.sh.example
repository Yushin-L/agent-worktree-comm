# Project-specific config for the `agents` orchestrator.
# Sourced by ./agents — bash variables only.
#
# Copy this file to `.agents.sh` and edit. `.agents.sh` is gitignored so
# each project's local config stays out of the comm repo.
#
# Required:
#   PROJECT          tmux session prefix (sessions become "<PROJECT>-<role>")
#   ROLES            bash array of role names; standard vocab: pm | back | front | review
#   REPO_URL         git URL cloned by `agents init` for each role
#
# Optional (with defaults if unset):
#   DEFAULT_AGENT_ENGINE  fallback engine for roles; claude (default) or codex
#   AGENT_ENGINES    associative role-to-engine map, e.g.
#                    declare -A AGENT_ENGINES=([pm]=codex [back]=claude)
#   CODEX_MODEL     model ID for Codex roles; unset/empty keeps the CLI default
#   CODEX_REASONING_EFFORT  Codex reasoning effort, e.g. high; default unset
#   CLAUDE_MODEL    model ID for Claude roles; unset/empty keeps the CLI default
#   CLAUDE_EFFORT   Claude effort level, e.g. high; default unset
#   EXTERNAL_WATCHER run the portable orchestrator-owned inbox watcher; default false
#   WATCH_POLL_INTERVAL  watcher polling interval in seconds; default 1
#   NO_ATTACH        start sessions without attaching after `up`; default false
#   SEPARATOR        between repo name and role; default "_"
#   ATTACH_TARGET    role to attach to on `agents up`; default "pm"
#   BOOT_SLEEP       initial grace (seconds) before polling the pane for
#                    readiness; default 2. No longer the sole gate — see below.
#   BOOT_READY_TIMEOUT  max seconds to poll for claude's TUI to accept input
#                    before injecting the prompt anyway; default 30. Raise on
#                    slow/first-run boots (e.g. many MCP servers initializing).
#   BOOT_READY_MARKER   pane substring that signals the input UI is rendered;
#                    default "❯" for Claude Code.
#   CODEX_READY_MARKER  Codex TUI input marker; default "› Ask Codex".
#   CODEX_TRUST_MARKER  Codex first-run trust dialog substring; accepted automatically.
#   BOOT_TRUST_MARKER   pane substring of claude's first-run "trust this folder"
#                    dialog; when seen while waiting for readiness the script
#                    presses Enter to accept it (cursor defaults to "Yes, I
#                    trust"), so the first `agents up` on fresh worktrees works
#                    and trust is persisted. Default "trust this folder";
#                    empty ⇒ auto-accept disabled.
#   BOOT_TRUST_NO_MARKER  regex matching the trust dialog when its cursor sits
#                    on "No, exit" (newer Claude Code defaults there when
#                    .claude/settings.json pre-approves permissions). When it
#                    matches, the script presses Down before Enter so "Yes, I
#                    trust" is selected. Default "❯[[:space:]]*No, exit".
#   BOOT_PROBE       ASCII substring used to confirm the bootstrap prompt landed
#                    in the composer; default = longest ASCII run in
#                    BOOTSTRAP_PROMPT. Set explicitly if your prompt is
#                    all-non-ASCII (empty ⇒ post-send verification is skipped).
#   BOOTSTRAP_PROMPT first text sent to each session after claude boots
#   CLAUDE_CMD       full command override for Claude roles; bypasses CLAUDE_MODEL
#                    and CLAUDE_EFFORT. Otherwise built from those settings.
#                    (e.g. "claude --continue" to resume the previous conversation)
#   CODEX_CMD        full command override; bypasses CODEX_MODEL and
#                    CODEX_REASONING_EFFORT and the default approval settings.
#                    Otherwise uses workspace-write with the comm directory added,
#                    on-request approvals and approvals_reviewer="auto_review".
#
# For irregular worktree layouts, override the resolver:
#   worktree_dir() {
#     case "$1" in
#       pm)     echo "main" ;;
#       *)      echo "wt-$1" ;;
#     esac
#   }

PROJECT=myproject
ROLES=(pm back front review)
REPO_URL=https://github.com/owner/repo.git
ATTACH_TARGET=pm

# Mixed-engine example:
# declare -A AGENT_ENGINES=([pm]=codex [back]=claude [front]=claude [review]=codex)
# EXTERNAL_WATCHER=true

# Optional model/effort selection (applies to every role using that engine):
# CODEX_MODEL=gpt-6-astra
# CODEX_REASONING_EFFORT=high
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=high
